# Build caches
.gocache
# Per-checkout golangci-lint cache isolates sibling worktrees.
/.golangci-cache/
.cache
.gomodcache/
.gopath/
# Local Go toolchain caches: build cache and module downloads land under
# .go/ (GOCACHE=.go/cache, GOMODCACHE=.go/pkg/mod). Ignore the whole tree
# so new cache entries stay hidden instead of listing each file.
/.go/

# Docs build and hydrated assets
docs/.venv/
docs/.zensical-build.*
docs/zensical-public-docs.*
docs/site/
docs/assets/static/
docs/assets/generated/
docs/.gitignore
docs/.vercel/
docs/.env*.local
.vercel
.env*.local

