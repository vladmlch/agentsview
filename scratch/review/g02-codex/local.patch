+		}
+		defer rows.Close()
+
+		t := make(map[string]string)
+		for rows.Next() {
+			var id, title string
+			if err := rows.Scan(&id, &title); err != nil {
+				return err
+			}
+			t[id] = title
+		}
+		if err := rows.Err(); err != nil {
+			return err
+		}
+		titles = t
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
