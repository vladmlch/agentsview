+			total:    100,
+			lengths:  []int{25, 75},
+			expected: []int64{25, 75},
+		},
+		{
+			name:     "remainder awarded to larger fractional share",
+			total:    10,
+			lengths:  []int{1, 2},
+			expected: []int64{3, 7},
