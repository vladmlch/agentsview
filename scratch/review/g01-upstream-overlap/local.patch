+	combinedFiles := requireClassifyPaths(t, engine, []string{dbPath, walPath, shmPath})
+	require.Len(t, combinedFiles, 1)
+	assert.Equal(t, parser.OpenCodeSQLiteVirtualPath(dbPath, "ses_wal"), combinedFiles[0].Path)
+}
