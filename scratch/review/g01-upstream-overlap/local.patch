+	shmPath := filepath.Join(opencodeDir, "opencode.db-shm")
+
+	// Classifying only shmPath should produce zero discovered files.
+	shmFiles := requireClassifyPaths(t, engine, []string{shmPath})
+	assert.Empty(t, shmFiles)
