+  let body = "";
+  let pos = 0;
+  for (const hit of hits) {
+    if (hit.start < pos) continue;
+    body += text.slice(pos, hit.start);
+    attachments.push(hit.marker);
+    pos = hit.end;
+  }
+  body += text.slice(pos);
